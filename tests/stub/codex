#!/usr/bin/env bash
# tandem tests — stub of the `codex` CLI binary.
#
# The runner COPIES this file to $SANDBOX/bin/codex (never a symlink: a symlink
# would keep resolving through the repo and a test could not shadow it) and
# prepends $SANDBOX/bin to PATH. Everything the stub does is selected by
# environment variables, never by shared scenario files, so two tests can never
# influence each other.
#
# Environment contract
#   CODEX_STUB_LOG          (required) base path for the per-invocation records
#   CODEX_STUB_SCENARIO     ok | multi-thread-started | resume-fallback | fail
#                           | empty-reply | no-thread-event | corrupt-ndjson
#                           | verdict-multi | hang | version-fail   (default ok)
#   CODEX_STUB_THREAD_ID    thread id emitted by thread.started (default thr_stub_1)
#   CODEX_STUB_THREAD_ID_2  second/alternate id (multi-thread-started, resume-fallback)
#   CODEX_STUB_REPLY        text written to --output-last-message
#   CODEX_STUB_REPLY_FILE   file whose content is written instead of _REPLY
#   CODEX_STUB_EXIT         exit code of the `fail` scenario (default 7 — a value
#                           that is neither 0 nor 1, so a caller that hardcodes
#                           `exit 1` is distinguishable from one that forwards rc)
#   CODEX_STUB_FIXTURE      NDJSON file emitted verbatim instead of the inline events
#   CODEX_STUB_SLEEP        seconds to sleep before emitting anything
#   CODEX_STUB_CONC_DIR     when set, the exec branch registers itself as a LIVE
#                           turn in that directory (marker `running.$$`, removed
#                           by its own EXIT trap) and snapshots how many stubs
#                           were alive at that instant into
#                           $CODEX_STUB_LOG.conc.N. That count is the observable
#                           behind "at most C simultaneous codex turns": it
#                           measures turns, not seconds, so the semaphore's cap
#                           is asserted without a single wall-clock assumption.
#   CODEX_STUB_VERSION_RC   exit code of `codex --version` (default 0)
#   CODEX_STUB_VERSION_TEXT text `codex --version` prints (default
#                           `codex-cli 0.0.0-stub` — doctor-env-matrix.test.sh
#                           asserts that exact string, so the default must stay
#                           intact; the MCP tests set `codex-cli 0.144.4` to
#                           satisfy the version gate of the STATIC verdicts)
#   CODEX_STUB_LOGIN_RC     exit code of `codex login …`   (default 0)
#   CODEX_STUB_CONFIG_REJECT  space-separated list of `-c` keys that `codex
#                           debug …` still KNOWS: it rejects a bad value for
#                           them (rc 1, naming the key). Every other key is
#                           accepted in SILENCE (rc 0) — the real 0.144.4
#                           behaviour for a key that does not exist, and the
#                           way a test simulates one being renamed away.
#   CODEX_STUB_DEBUG_RC     exit code of `codex debug …` with no `-c` at all
#                           (default 0 — the probe's preflight)
#   CODEX_STUB_HB_FILE      heartbeat snapshotted during the RUNNING phase
#                           (default $CLAUDE_PROJECT_DIR/.tandem/state/current.json)
#   CODEX_STUB_HELP_NO_EPHEMERAL  1 → `codex exec --help` omits `--ephemeral`,
#                           i.e. a CLI too old for the doctor's smoke
#   CODEX_STUB_HELP_RC      exit code of `codex exec --help` (default 0)
#
# `codex mcp-server` (its own branch, its own records — see below):
#   CODEX_STUB_MCP_SCENARIO ok | auth-error | hostile-inherited | reply-error
#                           | reply-silent | reply-no-thread | unsafe-inherited
#                           | hang-call
#                           | no-tools | garbage        (default ok)
#   CODEX_STUB_MCP_THREAD_ID  threadId the tools echo (default thr_mcp_stub_1)
#   CODEX_STUB_MCP_ROLLOUT  1 → the server writes a rollout with `turn_context`
#                           lines under $CODEX_HOME/sessions/, the way the real
#                           one does, so probe (c) has an effective config to
#                           read and probe (a) a file to resurrect
#   CODEX_STUB_MCP_REPLY    the text the `codex` tool answers with, and the text
#                           its agent_message frames carry (default OK)
#   CODEX_STUB_MCP_TOKENS_*  IN/CACHED/OUT/REASONING/TOTAL of the token_count
#                           frame (defaults 1234/1000/56/7/2290). TOTAL exists so
#                           a test can prove the adapter DROPS `total_tokens`:
#                           exec's Usage has four public fields and a fifth one
#                           in the ledger would be a field no exec turn carries
#   CODEX_STUB_MCP_HANG_RESISTANT  1 → the `hang-call` scenario also forks a
#                           child that ignores TERM (only KILL reaps it); its
#                           pid lands in CODEX_STUB_HANG_PIDFILE
#   CODEX_STUB_MCP_HANG_AFTER_EVENTS  1 → `hang-call` emits the WHOLE
#                           notification stream (turn.completed included) and
#                           only then hangs: a turn that already burned its
#                           quota must still reach the client's ledger
#
# Per-MODEL selectivity (the scenarios above are global to the process; the
# doctor's --smoke runs several models in ONE process, and "this model is gone
# but the next one answers" is a contract that only a per-model knob can state):
#   CODEX_STUB_FAIL_MODEL   the `--model` value that fails; every other model
#                           behaves normally
#   CODEX_STUB_FAIL_KIND    model (default) → stderr with model-not-found
#                           SEMANTICS · other → an auth-shaped stderr that
#                           merely mentions the model name
#   CODEX_STUB_HANG_MODEL   the `--model` value that hangs (the global `hang`
#                           scenario would hang every later model too)
#   CODEX_STUB_HANG_RESISTANT  1 -> the hanging model also forks a child that
#                           ignores TERM (only KILL reaps it); its pid lands in
#                           CODEX_STUB_HANG_PIDFILE for the caller to assert on
#
# Per-invocation records (N counts EXEC invocations only — `--version` and
# `login` probes do not advance the counter, so argv.1 is always the first real
# turn):
#   $CODEX_STUB_LOG.argv.N    full argv joined with \x1f (exact-order assertions)
#   $CODEX_STUB_LOG.stdin.N   the prompt, drained before any event is emitted
#   $CODEX_STUB_LOG.hb.N      copy of the heartbeat as it looked mid-turn
#   $CODEX_STUB_LOG.n         invocation counter
#
# MCP records live in a namespace of their OWN so the exec counter above (which
# the doctor's cost assertions meter) is never touched by a transport that
# spends nothing:
#   $CODEX_STUB_LOG.mcp.in       every JSON-RPC request line received
#   $CODEX_STUB_LOG.mcp.calls    tools/call counter (absent = not one call)
#   $CODEX_STUB_LOG.mcp.cfg.N    $CODEX_HOME/config.toml as it was AT call N
#   $CODEX_STUB_LOG.mcp.auth.N   present|absent of $CODEX_HOME/auth.json at call N
#   $CODEX_STUB_LOG.mcp.codeword the codeword RECOVERED from call 1's prompt
#   $CODEX_STUB_LOG.mcp.call1.*  model/effort/cwd as call 1 asked for them
#
# bash 3.2 compatible on purpose: this runs under whatever /bin/bash the
# platform ships.

set -u

STUB_US=$'\x1f'

stub_die() {
  printf 'codex-stub: %s\n' "$1" >&2
  exit 90
}

[ -n "${CODEX_STUB_LOG:-}" ] || stub_die "CODEX_STUB_LOG is not set (the runner must export it)"

SCENARIO="${CODEX_STUB_SCENARIO:-ok}"
TID="${CODEX_STUB_THREAD_ID:-thr_stub_1}"
TID2="${CODEX_STUB_THREAD_ID_2:-thr_stub_2}"

# --- dispatch: --version wins, then login, then debug, then the exec branch --
if [ "${1:-}" = "--version" ]; then
  rc="${CODEX_STUB_VERSION_RC:-0}"
  [ "$SCENARIO" = "version-fail" ] && rc="${CODEX_STUB_VERSION_RC:-1}"
  if [ "$rc" -eq 0 ]; then
    printf '%s\n' "${CODEX_STUB_VERSION_TEXT:-codex-cli 0.0.0-stub}"
  else
    printf 'codex-stub: simulated broken install\n' >&2
  fi
  exit "$rc"
fi

if [ "${1:-}" = "login" ]; then
  exit "${CODEX_STUB_LOGIN_RC:-0}"
fi

# `codex exec --help` is a capability PROBE, not a turn: like the debug branch
# it shares nothing with the exec branch below and does NOT advance the
# invocation counter, so a test that counts REAL turns (the doctor's --smoke)
# can assert 2 and mean 2.
if [ "${1:-}" = "exec" ] && [ "${2:-}" = "--help" ]; then
  printf 'Run Codex non-interactively\n\n'
  printf 'Usage: codex exec [OPTIONS] [PROMPT]\n\n'
  printf 'Options:\n'
  printf '  -c, --config <key=value>\n'
  printf '  -m, --model <MODEL>\n'
  printf '  -s, --sandbox <SANDBOX_MODE>\n'
  printf '  -C, --cd <DIR>\n'
  printf '      --skip-git-repo-check\n'
  if [ "${CODEX_STUB_HELP_NO_EPHEMERAL:-0}" != "1" ]; then
    printf '      --ephemeral\n'
  fi
  printf '      --ignore-user-config\n'
  printf '      --ignore-rules\n'
  printf '      --color <COLOR>\n'
  printf '      --json\n'
  printf '  -o, --output-last-message <FILE>\n'
  exit "${CODEX_STUB_HELP_RC:-0}"
fi

# `codex debug prompt-input …` validates the config and exits WITHOUT calling
# the model. It deliberately shares nothing with the exec branch below — in
# particular it does not advance the invocation counter, so a test can prove
# that scripts/config-probe.sh never started a real turn simply by asserting
# that no argv was ever recorded.
if [ "${1:-}" = "debug" ]; then
  stub_prev=""
  for a in "$@"; do
    if [ "$stub_prev" = "-c" ]; then
      stub_key="${a%%=*}"
      stub_val="${a#*=}"
      case " ${CODEX_STUB_CONFIG_REJECT:-} " in
        *" $stub_key "*)
          printf 'Error: unknown variant `%s` in `%s`\n' "$stub_val" "$stub_key" >&2
          exit 1
          ;;
      esac
    fi
    stub_prev="$a"
  done
  exit "${CODEX_STUB_DEBUG_RC:-0}"
fi

# --- mcp-server branch ------------------------------------------------------
# `codex mcp-server` speaks ndjson JSON-RPC over stdio. It shares NOTHING with
# the exec branch below: its own records (.mcp.*), and it never advances the
# exec invocation counter, so "not one real turn" stays a countable fact for
# both transports at once.
#
# The frame shapes below are the ones captured from the REAL 0.144.4 server in
# tests/fixtures/mcp-0.144.4/ (tests/mcp-fixture-conformance.test.sh contrasts
# the two and fails on divergence). The `turn_context` line of the rollout is
# the one shape with NO captured fixture yet — it costs a paid turn — so the
# stub emits a plausible item and the script's discriminator is value based
# rather than key based on purpose.
if [ "${1:-}" = "mcp-server" ]; then
  MCP_SCEN="${CODEX_STUB_MCP_SCENARIO:-ok}"
  MCP_TID="${CODEX_STUB_MCP_THREAD_ID:-thr_mcp_stub_1}"
  MCP_HOME="${CODEX_HOME:-}"

  # The `garbage` scenario writes junk BEFORE every frame: a client polling an
  # NDJSON file while it is being written must skip whatever jq refuses and
  # re-poll instead of breaking.
  mcp_noise() {
    [ "$MCP_SCEN" = "garbage" ] || return 0
    printf 'this line is not json at all\n'
    printf '{"jsonrpc":"2.0","id":\n'
    return 0
  }

  # mcp_idjson <raw> — the id as JSON: a number stays a number, anything else
  # becomes a string instead of invalid JSON.
  mcp_idjson() {
    case "$1" in
      '' | *[!0-9]*) jq -nc --arg i "$1" '$i' ;;
      *) printf '%s' "$1" ;;
    esac
  }

  mcp_initialize() {
    mcp_noise
    printf '{"jsonrpc":"2.0","id":%s,"result":{"protocolVersion":"2025-06-18","capabilities":{"tools":{"listChanged":true}},"serverInfo":{"name":"codex-mcp-server","title":"Codex","version":"0.144.4","user_agent":"codex_cli_rs/0.144.4 (stub)"}}}\n' \
      "$(mcp_idjson "$1")"
  }

  mcp_tools_list() {
    mcp_noise
    if [ "$MCP_SCEN" = "no-tools" ]; then
      printf '{"jsonrpc":"2.0","id":%s,"result":{"tools":[]}}\n' "$(mcp_idjson "$1")"
      return 0
    fi
    printf '{"jsonrpc":"2.0","id":%s,"result":{"tools":[' "$(mcp_idjson "$1")"
    printf '{"name":"codex","title":"Codex","description":"Run a Codex session. Accepts configuration parameters matching the Codex Config struct.","inputSchema":{"additionalProperties":false,"properties":'
    printf '{"approval-policy":{"description":"Approval policy for shell commands generated by the model.","type":"string","enum":["untrusted","on-request","never"]},'
    printf '"base-instructions":{"description":"The set of instructions to use instead of the default ones.","type":"string"},'
    printf '"compact-prompt":{"description":"Prompt used when compacting the conversation.","type":"string"},'
    printf '"config":{"description":"Individual config settings that will override what is in CODEX_HOME/config.toml.","type":"object","additionalProperties":true},'
    printf '"cwd":{"description":"Working directory for the session. If relative, it is resolved against the server process current working directory.","type":"string"},'
    printf '"developer-instructions":{"description":"Developer instructions that should be injected as a developer role message.","type":"string"},'
    printf '"model":{"description":"Optional override for the model name.","type":"string"},'
    printf '"prompt":{"description":"The initial user prompt to start the Codex conversation.","type":"string"},'
    printf '"sandbox":{"description":"Sandbox mode.","type":"string","enum":["read-only","workspace-write","danger-full-access"]}},'
    printf '"required":["prompt"],"type":"object"},"outputSchema":{"type":"object","properties":{"threadId":{"type":"string"},"content":{"type":"string"}},"required":["threadId","content"]}},'
    printf '{"name":"codex-reply","title":"Codex Reply","description":"Continue a Codex conversation by providing the thread id and prompt.","inputSchema":{"properties":'
    printf '{"conversationId":{"description":"DEPRECATED: use threadId instead.","type":"string"},'
    printf '"prompt":{"description":"The next user prompt to continue the Codex conversation.","type":"string"},'
    printf '"threadId":{"description":"The thread id for this Codex session.","type":"string"}},'
    printf '"required":["prompt"],"type":"object"},"outputSchema":{"type":"object","properties":{"threadId":{"type":"string"},"content":{"type":"string"}},"required":["threadId","content"]}}'
    printf ']}}\n'
    return 0
  }

  # The rollout the real server writes through its RolloutRecorder:
  # CODEX_HOME/sessions/YYYY/MM/DD/rollout-…-<ThreadId>.jsonl, one turn_context
  # item appended per turn.
  # mcp_rollout_append <model> <effort> <cwd> [approval] [sandbox] — one
  # turn_context line. The last two default to the pinned policy; a scenario
  # passes them to emit a DEGRADED context on purpose.
  mcp_rollout_append() {
    local model="$1" effort="$2" cwd="$3" approval="${4:-never}" sandbox="${5:-read-only}" dir file
    [ "${CODEX_STUB_MCP_ROLLOUT:-0}" = "1" ] || return 0
    [ -n "$MCP_HOME" ] || return 0
    dir="$MCP_HOME/sessions/2026/08/02"
    mkdir -p "$dir" 2>/dev/null || return 0
    file="$dir/rollout-2026-08-02T00-00-00-$MCP_TID.jsonl"
    printf '{"timestamp":"2026-08-02T00:00:00.000Z","type":"turn_context","payload":{"cwd":"%s","approval_policy":"%s","sandbox_policy":{"type":"%s"},"model":"%s","effort":"%s"}}\n' \
      "$cwd" "$approval" "$sandbox" "$model" "$effort" >>"$file"
    return 0
  }

  # The model/effort the home's config.toml carries RIGHT NOW — how a server
  # that re-read the user config on a continuation would behave.
  mcp_cfg_field() {
    [ -n "$MCP_HOME" ] || return 0
    [ -f "$MCP_HOME/config.toml" ] || return 0
    LC_ALL=C sed -n "s/^$1 = \"\(.*\)\"\$/\1/p" "$MCP_HOME/config.toml" 2>/dev/null | head -n 1
  }

  # --- the codex/event notification stream ----------------------------------
  # Shapes copied from tests/fixtures/mcp-0.144.4/notifications.ndjson, the 14
  # structural frames of a REAL 0.144.4 turn: params={_meta,id,msg} with msg
  # types session_configured / mcp_startup_update / task_started / item_started /
  # item_completed / user_message / agent_message* / token_count / task_complete.
  # scripts/_mcp.sh:mcp_events_adapt is the consumer, and
  # tests/mcp-transport-parity.test.sh replays the REAL fixture through it so a
  # stub that drifted from those bytes cannot keep the suite green on its own.
  #
  # The CommandExecution item is the ONE shape with no captured fixture — the
  # real M19 turn ran no command — so it is RECONSTRUCTED exactly like the
  # `turn_context` line above: PascalCase item type, exec's own field names. It
  # is marked as such on purpose; it is not captured ground truth.
  mcp_event() {
    # mcp_event <request-id> <event-id> <msg-json>
    jq -nc --argjson rid "$(mcp_idjson "$1")" --arg tid "$MCP_TID" \
      --arg eid "$2" --argjson msg "$3" \
      '{jsonrpc:"2.0", method:"codex/event",
        params:{_meta:{requestId:$rid, threadId:$tid}, id:$eid, msg:$msg}}'
  }

  # mcp_notify_turn <request-id> <prompt> <model> <effort> <cwd>
  mcp_notify_turn() {
    local rid="$1" prompt="$2" model="$3" effort="$4" cwd="$5"
    local reply="${CODEX_STUB_MCP_REPLY:-OK}" rollout=""
    if [ -n "$MCP_HOME" ] && [ "${CODEX_STUB_MCP_ROLLOUT:-0}" = "1" ]; then
      rollout="$MCP_HOME/sessions/2026/08/02/rollout-2026-08-02T00-00-00-$MCP_TID.jsonl"
    fi
    mcp_event "$rid" "" "$(jq -nc --arg tid "$MCP_TID" --arg cwd "$cwd" \
      --arg model "$model" --arg effort "$effort" --arg rollout "$rollout" \
      '{approval_policy:"never", approvals_reviewer:"user", cwd:$cwd, model:$model,
        model_provider_id:"openai", reasoning_effort:$effort, rollout_path:$rollout,
        session_id:$tid, thread_id:$tid, type:"session_configured"}')"
    mcp_event "$rid" "" \
      '{"server":"codex_apps","status":{"state":"ready"},"type":"mcp_startup_update"}'
    mcp_event "$rid" "$rid" "$(jq -nc --arg t "$rid" \
      '{collaboration_mode_kind:"default", model_context_window:258400,
        started_at:1785698969, turn_id:$t, type:"task_started"}')"
    mcp_event "$rid" "$rid" "$(jq -nc --arg p "$prompt" --arg tid "$MCP_TID" --arg t "$rid" \
      '{item:{content:[{text:$p, text_elements:[], type:"text"}],
              id:"stub-user-item", type:"UserMessage"},
        started_at_ms:1785698971940, thread_id:$tid, turn_id:$t, type:"item_started"}')"
    mcp_event "$rid" "$rid" "$(jq -nc --arg p "$prompt" --arg tid "$MCP_TID" --arg t "$rid" \
      '{completed_at_ms:1785698971940,
        item:{content:[{text:$p, text_elements:[], type:"text"}],
              id:"stub-user-item", type:"UserMessage"},
        thread_id:$tid, turn_id:$t, type:"item_completed"}')"
    mcp_event "$rid" "$rid" "$(jq -nc --arg p "$prompt" \
      '{images:[], local_images:[], message:$p, text_elements:[], type:"user_message"}')"
    # RECONSTRUCTED (no captured fixture): a command execution item.
    mcp_event "$rid" "$rid" "$(jq -nc --arg tid "$MCP_TID" --arg t "$rid" \
      '{item:{command:"echo   hello\nworld", aggregated_output:"", exit_code:null,
              id:"stub-cmd-item", status:"in_progress", type:"CommandExecution"},
        started_at_ms:1785698972000, thread_id:$tid, turn_id:$t, type:"item_started"}')"
    mcp_event "$rid" "$rid" "$(jq -nc --arg tid "$MCP_TID" --arg t "$rid" \
      '{completed_at_ms:1785698972500,
        item:{command:"echo hello", aggregated_output:"hello", exit_code:0,
              id:"stub-cmd-item", status:"completed", type:"CommandExecution"},
        thread_id:$tid, turn_id:$t, type:"item_completed"}')"
    mcp_event "$rid" "$rid" "$(jq -nc --arg tid "$MCP_TID" --arg t "$rid" \
      '{item:{content:[{text:"", type:"Text"}], id:"stub-agent-item",
              phase:"final_answer", type:"AgentMessage"},
        started_at_ms:1785698973629, thread_id:$tid, turn_id:$t, type:"item_started"}')"
    mcp_event "$rid" "$rid" "$(jq -nc --arg r "$reply" --arg tid "$MCP_TID" --arg t "$rid" \
      '{delta:$r, item_id:"stub-agent-item", thread_id:$tid, turn_id:$t,
        type:"agent_message_content_delta"}')"
    mcp_event "$rid" "$rid" "$(jq -nc --arg r "$reply" --arg tid "$MCP_TID" --arg t "$rid" \
      '{completed_at_ms:1785698973699,
        item:{content:[{text:$r, type:"Text"}], id:"stub-agent-item",
              phase:"final_answer", type:"AgentMessage"},
        thread_id:$tid, turn_id:$t, type:"item_completed"}')"
    mcp_event "$rid" "$rid" "$(jq -nc --arg r "$reply" \
      '{memory_citation:null, message:$r, phase:"final_answer", type:"agent_message"}')"
    mcp_event "$rid" "$rid" "$(jq -nc \
      --argjson i "${CODEX_STUB_MCP_TOKENS_IN:-1234}" \
      --argjson c "${CODEX_STUB_MCP_TOKENS_CACHED:-1000}" \
      --argjson o "${CODEX_STUB_MCP_TOKENS_OUT:-56}" \
      --argjson r "${CODEX_STUB_MCP_TOKENS_REASONING:-7}" \
      --argjson tt "${CODEX_STUB_MCP_TOKENS_TOTAL:-2290}" \
      '{info:{last_token_usage:{cached_input_tokens:$c, input_tokens:$i,
                                output_tokens:$o, reasoning_output_tokens:$r,
                                total_tokens:$tt},
              model_context_window:258400,
              total_token_usage:{cached_input_tokens:$c, input_tokens:$i,
                                 output_tokens:$o, reasoning_output_tokens:$r,
                                 total_tokens:$tt}},
        rate_limits:null, type:"token_count"}')"
    mcp_event "$rid" "$rid" "$(jq -nc --arg r "$reply" --arg t "$rid" \
      '{completed_at:1785698973, duration_ms:4528, last_agent_message:$r,
        time_to_first_token_ms:4448, turn_id:$t, type:"task_complete"}')"
    return 0
  }

  mcp_ok_result() {
    local id="$1" text="$2"
    mcp_noise
    jq -nc --argjson id "$(mcp_idjson "$id")" --arg t "$MCP_TID" --arg c "$text" \
      '{jsonrpc:"2.0", id:$id,
        result:{content:[{type:"text", text:$c}],
                structuredContent:{threadId:$t, content:$c}, isError:false}}'
  }

  mcp_error_result() {
    local id="$1" text="$2"
    mcp_noise
    jq -nc --argjson id "$(mcp_idjson "$id")" --arg c "$text" \
      '{jsonrpc:"2.0", id:$id, result:{content:[{type:"text", text:$c}], isError:true}}'
  }

  mcp_call() {
    local id="$1" line="$2" n=0 tool prompt model effort cwd cw
    n=0
    if [ -f "$CODEX_STUB_LOG.mcp.calls" ]; then
      n="$(cat "$CODEX_STUB_LOG.mcp.calls" 2>/dev/null || printf '0')"
    fi
    case "$n" in '' | *[!0-9]*) n=0 ;; esac
    n=$((n + 1))
    printf '%s\n' "$n" >"$CODEX_STUB_LOG.mcp.calls"

    # Snapshots taken AT the call: this is what makes a config rewritten
    # BETWEEN two calls observable from a test.
    if [ -n "$MCP_HOME" ] && [ -f "$MCP_HOME/config.toml" ]; then
      cp "$MCP_HOME/config.toml" "$CODEX_STUB_LOG.mcp.cfg.$n" 2>/dev/null || true
    fi
    if [ -n "$MCP_HOME" ] && [ -f "$MCP_HOME/auth.json" ]; then
      printf 'present\n' >"$CODEX_STUB_LOG.mcp.auth.$n"
    else
      printf 'absent\n' >"$CODEX_STUB_LOG.mcp.auth.$n"
    fi

    if [ "$MCP_SCEN" = "hang-call" ]; then
      # CODEX_STUB_MCP_HANG_AFTER_EVENTS=1 emits the WHOLE notification stream
      # and only then hangs: the turn produced its `turn.completed` and burned
      # its quota, so a client that let the watchdog kill it without running the
      # accounting would silently lose a paid turn. That is the case the knob
      # exists to make observable.
      if [ "${CODEX_STUB_MCP_HANG_AFTER_EVENTS:-0}" = "1" ]; then
        model="$(printf '%s' "$line" | jq -r '.params.arguments.model // empty' 2>/dev/null)"
        effort="$(printf '%s' "$line" | jq -r '.params.arguments.config["model_reasoning_effort"] // empty' 2>/dev/null)"
        cwd="$(printf '%s' "$line" | jq -r '.params.arguments.cwd // empty' 2>/dev/null)"
        prompt="$(printf '%s' "$line" | jq -r '.params.arguments.prompt // empty' 2>/dev/null)"
        mcp_rollout_append "$model" "$effort" "$cwd"
        mcp_notify_turn "$id" "$prompt" "$model" "$effort" "$cwd"
      fi
      if [ "${CODEX_STUB_MCP_HANG_RESISTANT:-0}" = "1" ]; then
        (
          trap '' TERM
          sleep "${CODEX_STUB_HANG_SECONDS:-600}"
        ) &
        if [ -n "${CODEX_STUB_HANG_PIDFILE:-}" ]; then
          printf '%s\n' "$!" >"$CODEX_STUB_HANG_PIDFILE"
        fi
      fi
      # No answer, ever: only the client's watchdog can end this.
      sleep "${CODEX_STUB_HANG_SECONDS:-600}"
      return 0
    fi
    if [ "$MCP_SCEN" = "auth-error" ]; then
      mcp_error_result "$id" \
        'Error: 401 Unauthorized — the stored token was rejected. Run `codex login`.'
      return 0
    fi

    tool="$(printf '%s' "$line" | jq -r '.params.name // empty' 2>/dev/null)"
    if [ "$tool" = "codex" ]; then
      model="$(printf '%s' "$line" | jq -r '.params.arguments.model // empty' 2>/dev/null)"
      effort="$(printf '%s' "$line" | jq -r '.params.arguments.config["model_reasoning_effort"] // empty' 2>/dev/null)"
      cwd="$(printf '%s' "$line" | jq -r '.params.arguments.cwd // empty' 2>/dev/null)"
      printf '%s' "$model" >"$CODEX_STUB_LOG.mcp.call1.model"
      printf '%s' "$effort" >"$CODEX_STUB_LOG.mcp.call1.effort"
      printf '%s' "$cwd" >"$CODEX_STUB_LOG.mcp.call1.cwd"
      # The codeword is RECOVERED from what call 1 actually sent, never
      # hardcoded: an answer built from a value the stub knew in advance would
      # prove nothing about memory.
      prompt="$(printf '%s' "$line" | jq -r '.params.arguments.prompt // empty' 2>/dev/null)"
      cw="$(printf '%s\n' "$prompt" | LC_ALL=C sed -n 's/^codeword: //p' | head -n 1)"
      if [ -n "$cw" ]; then
        printf '%s\n' "$cw" >"$CODEX_STUB_LOG.mcp.codeword"
      fi
      mcp_rollout_append "$model" "$effort" "$cwd"
      # The notification stream comes BEFORE the result, exactly as the real
      # server orders it: the client adapts what it read once the call answers.
      mcp_notify_turn "$id" "$prompt" "$model" "$effort" "$cwd"
      mcp_ok_result "$id" "${CODEX_STUB_MCP_REPLY:-OK}"
      return 0
    fi

    # codex-reply: the continuation.
    # `reply-error`: the call fails and appends NOTHING — the case that would let
    # a probe read call 1's own turn_context and certify a failed continuation.
    if [ "$MCP_SCEN" = "reply-error" ]; then
      mcp_error_result "$id" "the continuation failed: model stream error"
      return 0
    fi
    # `reply-silent`: the call SUCCEEDS but appends no turn_context — same trap,
    # without an error to notice it by.
    if [ "$MCP_SCEN" = "reply-silent" ]; then
      mcp_ok_result "$id" "OK"
      return 0
    fi
    # `reply-no-thread`: a perfectly good continuation that appends a pinned
    # context but echoes NO threadId — the answer cannot be tied to the thread.
    if [ "$MCP_SCEN" = "reply-no-thread" ]; then
      model="$(cat "$CODEX_STUB_LOG.mcp.call1.model" 2>/dev/null || printf '')"
      effort="$(cat "$CODEX_STUB_LOG.mcp.call1.effort" 2>/dev/null || printf '')"
      cwd="$(cat "$CODEX_STUB_LOG.mcp.call1.cwd" 2>/dev/null || printf '')"
      mcp_rollout_append "$model" "$effort" "$cwd"
      printf '{"jsonrpc":"2.0","id":%s,"result":{"content":[{"type":"text","text":"OK"}],"structuredContent":{"content":"OK"}}}\n' "$id"
      return 0
    fi
    # `unsafe-inherited`: model and effort are inherited correctly, but the
    # continuation's turn_context carries a DEGRADED sandbox/approval — the half
    # of the promise that a model-only check would miss.
    if [ "$MCP_SCEN" = "unsafe-inherited" ]; then
      model="$(cat "$CODEX_STUB_LOG.mcp.call1.model" 2>/dev/null || printf '')"
      effort="$(cat "$CODEX_STUB_LOG.mcp.call1.effort" 2>/dev/null || printf '')"
      cwd="$(cat "$CODEX_STUB_LOG.mcp.call1.cwd" 2>/dev/null || printf '')"
      mcp_rollout_append "$model" "$effort" "$cwd" "on-request" "danger-full-access"
      mcp_ok_result "$id" "OK"
      return 0
    fi
    # `hostile-inherited` is the server that RE-READ the home's config.toml, so
    # its turn_context echoes whatever sits there now instead of call 1's pins.
    if [ "$MCP_SCEN" = "hostile-inherited" ]; then
      model="$(mcp_cfg_field model)"
      effort="$(mcp_cfg_field model_reasoning_effort)"
    else
      model="$(cat "$CODEX_STUB_LOG.mcp.call1.model" 2>/dev/null || printf '')"
      effort="$(cat "$CODEX_STUB_LOG.mcp.call1.effort" 2>/dev/null || printf '')"
    fi
    cwd="$(cat "$CODEX_STUB_LOG.mcp.call1.cwd" 2>/dev/null || printf '')"
    mcp_rollout_append "$model" "$effort" "$cwd"
    mcp_ok_result "$id" "OK"
    return 0
  }

  while IFS= read -r mcp_line; do
    [ -n "$mcp_line" ] || continue
    printf '%s\n' "$mcp_line" >>"$CODEX_STUB_LOG.mcp.in"
    mcp_method="$(printf '%s' "$mcp_line" | jq -r '.method // empty' 2>/dev/null)"
    mcp_id="$(printf '%s' "$mcp_line" | jq -r 'if has("id") then (.id | tostring) else "" end' 2>/dev/null)"
    case "$mcp_method" in
      initialize) mcp_initialize "$mcp_id" ;;
      notifications/initialized) : ;;
      tools/list) mcp_tools_list "$mcp_id" ;;
      tools/call) mcp_call "$mcp_id" "$mcp_line" ;;
      *) : ;;
    esac
  done
  exit 0
fi

# --- exec branch ------------------------------------------------------------
N_FILE="$CODEX_STUB_LOG.n"
N=0
if [ -f "$N_FILE" ]; then
  N="$(cat "$N_FILE" 2>/dev/null || printf '0')"
fi
case "$N" in '' | *[!0-9]*) N=0 ;; esac
N=$((N + 1))
printf '%s\n' "$N" >"$N_FILE"

ARGV=""
SEP=""
for a in "$@"; do
  ARGV="$ARGV$SEP$a"
  SEP="$STUB_US"
done
printf '%s' "$ARGV" >"$CODEX_STUB_LOG.argv.$N"

# Drain the prompt BEFORE emitting anything: the callers pipe us into tee and
# would deadlock on a large prompt otherwise, and the recorded stdin is what the
# tests assert the rendered template against.
cat >"$CODEX_STUB_LOG.stdin.$N"

# Snapshot the heartbeat while the turn is RUNNING. This is the only moment the
# "running heartbeat carries the NDJSON path" contract is observable: by the
# time the caller returns, hb_end has already overwritten it.
HB_FILE="${CODEX_STUB_HB_FILE:-${CLAUDE_PROJECT_DIR:-}/.tandem/state/current.json}"
if [ -n "$HB_FILE" ] && [ -f "$HB_FILE" ]; then
  cp "$HB_FILE" "$CODEX_STUB_LOG.hb.$N" 2>/dev/null || true
fi

# Concurrency census. The marker goes up FIRST so this turn counts itself, and
# the count is taken before any sleep: it is the number of codex turns that were
# genuinely running at the moment this one started. `find`, never `ls` — the
# stub is shellchecked like everything else in tests/.
if [ -n "${CODEX_STUB_CONC_DIR:-}" ]; then
  mkdir -p "$CODEX_STUB_CONC_DIR" 2>/dev/null || true
  STUB_CONC_MARK="$CODEX_STUB_CONC_DIR/running.$$"
  : >"$STUB_CONC_MARK"
  trap 'rm -f "$STUB_CONC_MARK"' EXIT
  find "$CODEX_STUB_CONC_DIR" -mindepth 1 -maxdepth 1 | wc -l | tr -d ' ' \
    >"$CODEX_STUB_LOG.conc.$N"
fi

WANT_JSON=0
OUT_LAST=""
STUB_MODEL=""
prev=""
for a in "$@"; do
  [ "$a" = "--json" ] && WANT_JSON=1
  [ "$prev" = "--output-last-message" ] && OUT_LAST="$a"
  [ "$prev" = "--model" ] && STUB_MODEL="$a"
  prev="$a"
done

# --- per-model selectivity ---------------------------------------------------
# Checked before the global knobs so a multi-model caller can single one out.
if [ -n "${CODEX_STUB_HANG_MODEL:-}" ] && [ "$STUB_MODEL" = "$CODEX_STUB_HANG_MODEL" ]; then
  # CODEX_STUB_HANG_RESISTANT=1 forks a child that IGNORES TERM and records its
  # pid in CODEX_STUB_HANG_PIDFILE: the caller's watchdog must complete its
  # TERM->KILL sequence for that child to die, which is exactly the contract the
  # doctor's smoke cleanup test asserts.
  if [ "${CODEX_STUB_HANG_RESISTANT:-0}" = "1" ]; then
    (
      trap '' TERM
      sleep "${CODEX_STUB_HANG_SECONDS:-600}"
    ) &
    if [ -n "${CODEX_STUB_HANG_PIDFILE:-}" ]; then
      printf '%s\n' "$!" >"$CODEX_STUB_HANG_PIDFILE"
    fi
  fi
  sleep "${CODEX_STUB_HANG_SECONDS:-600}"
  exit 0
fi
if [ -n "${CODEX_STUB_FAIL_MODEL:-}" ] && [ "$STUB_MODEL" = "$CODEX_STUB_FAIL_MODEL" ]; then
  case "${CODEX_STUB_FAIL_KIND:-model}" in
    model)
      # The SEMANTICS of an unavailable model, the way the API words it.
      printf 'Error: The model `%s` does not exist or you do not have access to it.\n' \
        "$STUB_MODEL" >&2
      ;;
    *)
      # An auth failure that MENTIONS the model: a classifier keying on the
      # mere presence of the name would call this a deprecation.
      printf 'Error: 401 Unauthorized while starting a turn (model: %s). Run `codex login`.\n' \
        "$STUB_MODEL" >&2
      ;;
  esac
  exit "${CODEX_STUB_EXIT:-7}"
fi

if [ -n "${CODEX_STUB_SLEEP:-}" ]; then
  sleep "$CODEX_STUB_SLEEP"
fi
if [ "$SCENARIO" = "hang" ]; then
  # Long enough that only the caller's watchdog can end it. The resistant
  # descendant makes the TERM→KILL half of that contract observable.
  if [ "${CODEX_STUB_HANG_RESISTANT:-0}" = "1" ]; then
    (
      trap '' TERM
      sleep "${CODEX_STUB_HANG_SECONDS:-600}"
    ) &
    if [ -n "${CODEX_STUB_HANG_PIDFILE:-}" ]; then
      printf '%s\n' "$!" >"$CODEX_STUB_HANG_PIDFILE"
    fi
  fi
  sleep "${CODEX_STUB_HANG_SECONDS:-600}"
  exit 0
fi

emit() {
  [ "$WANT_JSON" -eq 1 ] || return 0
  printf '%s\n' "$1"
}

emit_events() {
  if [ -n "${CODEX_STUB_FIXTURE:-}" ]; then
    [ "$WANT_JSON" -eq 1 ] || return 0
    cat "$CODEX_STUB_FIXTURE"
    return 0
  fi
  case "$SCENARIO" in
    no-thread-event)
      : ;;
    multi-thread-started)
      emit "{\"type\":\"thread.started\",\"thread_id\":\"$TID\"}"
      ;;
    resume-fallback)
      emit "{\"type\":\"thread.started\",\"thread_id\":\"$TID2\"}"
      ;;
    corrupt-ndjson)
      emit 'not json at all'
      emit '{"type":"thread.started","thread_id":'
      emit "{\"type\":\"thread.started\",\"thread_id\":\"$TID\"}"
      ;;
    *)
      emit "{\"type\":\"thread.started\",\"thread_id\":\"$TID\"}"
      ;;
  esac

  emit '{"type":"item.started","item":{"item_type":"command_execution","command":"echo   hello\nworld"}}'
  emit '{"type":"item.completed","item":{"item_type":"command_execution","command":"echo hello","exit_code":0}}'

  if [ "$SCENARIO" = "multi-thread-started" ]; then
    emit "{\"type\":\"thread.started\",\"thread_id\":\"$TID2\"}"
  fi
  if [ "$SCENARIO" = "corrupt-ndjson" ]; then
    emit '}{ still garbage'
  fi

  case "$SCENARIO" in
    fail)
      emit '{"type":"turn.failed","error":{"message":"stub forced failure"}}'
      ;;
    *)
      # Usage values overridable per invocation so a retry test can tell two
      # attempts' ledger entries apart; defaults preserve every existing
      # assertion.
      emit "{\"type\":\"turn.completed\",\"usage\":{\"input_tokens\":${CODEX_STUB_TOKENS_IN:-1234},\"output_tokens\":${CODEX_STUB_TOKENS_OUT:-56}}}"
      ;;
  esac
}

reply_text() {
  if [ -n "${CODEX_STUB_REPLY_FILE:-}" ] && [ -f "$CODEX_STUB_REPLY_FILE" ]; then
    cat "$CODEX_STUB_REPLY_FILE"
    return 0
  fi
  if [ -n "${CODEX_STUB_REPLY:-}" ]; then
    printf '%s\n' "$CODEX_STUB_REPLY"
    return 0
  fi
  case "$SCENARIO" in
    verdict-multi)
      printf 'first pass\nVERDICT: NEEDS_REWORK\nsecond thoughts\nVERDICT:  APPROVED\n'
      ;;
    *)
      printf 'stub reply for %s\n' "$SCENARIO"
      ;;
  esac
}

emit_events

# A complete event stream means the quota is already spent even if the
# process wedges before returning. This knob keeps that accounting path
# distinct from the pure `hang` scenario, which emits no turn.completed.
if [ "${CODEX_STUB_HANG_AFTER_EVENTS:-0}" = "1" ]; then
  sleep "${CODEX_STUB_HANG_SECONDS:-600}"
  exit 0
fi

# `empty-reply` and `fail` deliberately do NOT write the last-message file: the
# callers pre-delete it, so a stale reply from a previous turn can never be
# mistaken for this turn's output — that pre-deletion is only observable here.
case "$SCENARIO" in
  empty-reply | fail) : ;;
  *)
    if [ -n "$OUT_LAST" ]; then
      reply_text >"$OUT_LAST"
    fi
    ;;
esac

if [ "$SCENARIO" = "fail" ]; then
  printf 'codex-stub: forced failure (scenario=fail)\n' >&2
  exit "${CODEX_STUB_EXIT:-7}"
fi

exit 0

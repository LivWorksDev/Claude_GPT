#!/usr/bin/env bash
# tandem tests — stub of the `codex` CLI binary.
#
# The runner COPIES this file to $SANDBOX/bin/codex (never a symlink: a symlink
# would keep resolving through the repo and a test could not shadow it) and
# prepends $SANDBOX/bin to PATH. Everything the stub does is selected by
# environment variables, never by shared scenario files, so two tests can never
# influence each other.
#
# Environment contract
#   CODEX_STUB_LOG          (required) base path for the per-invocation records
#   CODEX_STUB_SCENARIO     ok | multi-thread-started | resume-fallback | fail
#                           | empty-reply | no-thread-event | corrupt-ndjson
#                           | verdict-multi | hang | version-fail   (default ok)
#   CODEX_STUB_THREAD_ID    thread id emitted by thread.started (default thr_stub_1)
#   CODEX_STUB_THREAD_ID_2  second/alternate id (multi-thread-started, resume-fallback)
#   CODEX_STUB_REPLY        text written to --output-last-message
#   CODEX_STUB_REPLY_FILE   file whose content is written instead of _REPLY
#   CODEX_STUB_EXIT         exit code of the `fail` scenario (default 7 — a value
#                           that is neither 0 nor 1, so a caller that hardcodes
#                           `exit 1` is distinguishable from one that forwards rc)
#   CODEX_STUB_FIXTURE      NDJSON file emitted verbatim instead of the inline events
#   CODEX_STUB_SLEEP        seconds to sleep before emitting anything
#   CODEX_STUB_CONC_DIR     when set, the exec branch registers itself as a LIVE
#                           turn in that directory (marker `running.$$`, removed
#                           by its own EXIT trap) and snapshots how many stubs
#                           were alive at that instant into
#                           $CODEX_STUB_LOG.conc.N. That count is the observable
#                           behind "at most C simultaneous codex turns": it
#                           measures turns, not seconds, so the semaphore's cap
#                           is asserted without a single wall-clock assumption.
#   CODEX_STUB_VERSION_RC   exit code of `codex --version` (default 0)
#   CODEX_STUB_LOGIN_RC     exit code of `codex login …`   (default 0)
#   CODEX_STUB_CONFIG_REJECT  space-separated list of `-c` keys that `codex
#                           debug …` still KNOWS: it rejects a bad value for
#                           them (rc 1, naming the key). Every other key is
#                           accepted in SILENCE (rc 0) — the real 0.144.4
#                           behaviour for a key that does not exist, and the
#                           way a test simulates one being renamed away.
#   CODEX_STUB_DEBUG_RC     exit code of `codex debug …` with no `-c` at all
#                           (default 0 — the probe's preflight)
#   CODEX_STUB_HB_FILE      heartbeat snapshotted during the RUNNING phase
#                           (default $CLAUDE_PROJECT_DIR/.tandem/state/current.json)
#   CODEX_STUB_HELP_NO_EPHEMERAL  1 → `codex exec --help` omits `--ephemeral`,
#                           i.e. a CLI too old for the doctor's smoke
#   CODEX_STUB_HELP_RC      exit code of `codex exec --help` (default 0)
#
# Per-MODEL selectivity (the scenarios above are global to the process; the
# doctor's --smoke runs several models in ONE process, and "this model is gone
# but the next one answers" is a contract that only a per-model knob can state):
#   CODEX_STUB_FAIL_MODEL   the `--model` value that fails; every other model
#                           behaves normally
#   CODEX_STUB_FAIL_KIND    model (default) → stderr with model-not-found
#                           SEMANTICS · other → an auth-shaped stderr that
#                           merely mentions the model name
#   CODEX_STUB_HANG_MODEL   the `--model` value that hangs (the global `hang`
#                           scenario would hang every later model too)
#   CODEX_STUB_HANG_RESISTANT  1 -> the hanging model also forks a child that
#                           ignores TERM (only KILL reaps it); its pid lands in
#                           CODEX_STUB_HANG_PIDFILE for the caller to assert on
#
# Per-invocation records (N counts EXEC invocations only — `--version` and
# `login` probes do not advance the counter, so argv.1 is always the first real
# turn):
#   $CODEX_STUB_LOG.argv.N    full argv joined with \x1f (exact-order assertions)
#   $CODEX_STUB_LOG.stdin.N   the prompt, drained before any event is emitted
#   $CODEX_STUB_LOG.hb.N      copy of the heartbeat as it looked mid-turn
#   $CODEX_STUB_LOG.n         invocation counter
#
# bash 3.2 compatible on purpose: this runs under whatever /bin/bash the
# platform ships.

set -u

STUB_US=$'\x1f'

stub_die() {
  printf 'codex-stub: %s\n' "$1" >&2
  exit 90
}

[ -n "${CODEX_STUB_LOG:-}" ] || stub_die "CODEX_STUB_LOG is not set (the runner must export it)"

SCENARIO="${CODEX_STUB_SCENARIO:-ok}"
TID="${CODEX_STUB_THREAD_ID:-thr_stub_1}"
TID2="${CODEX_STUB_THREAD_ID_2:-thr_stub_2}"

# --- dispatch: --version wins, then login, then debug, then the exec branch --
if [ "${1:-}" = "--version" ]; then
  rc="${CODEX_STUB_VERSION_RC:-0}"
  [ "$SCENARIO" = "version-fail" ] && rc="${CODEX_STUB_VERSION_RC:-1}"
  if [ "$rc" -eq 0 ]; then
    printf 'codex-cli 0.0.0-stub\n'
  else
    printf 'codex-stub: simulated broken install\n' >&2
  fi
  exit "$rc"
fi

if [ "${1:-}" = "login" ]; then
  exit "${CODEX_STUB_LOGIN_RC:-0}"
fi

# `codex exec --help` is a capability PROBE, not a turn: like the debug branch
# it shares nothing with the exec branch below and does NOT advance the
# invocation counter, so a test that counts REAL turns (the doctor's --smoke)
# can assert 2 and mean 2.
if [ "${1:-}" = "exec" ] && [ "${2:-}" = "--help" ]; then
  printf 'Run Codex non-interactively\n\n'
  printf 'Usage: codex exec [OPTIONS] [PROMPT]\n\n'
  printf 'Options:\n'
  printf '  -c, --config <key=value>\n'
  printf '  -m, --model <MODEL>\n'
  printf '  -s, --sandbox <SANDBOX_MODE>\n'
  printf '  -C, --cd <DIR>\n'
  printf '      --skip-git-repo-check\n'
  if [ "${CODEX_STUB_HELP_NO_EPHEMERAL:-0}" != "1" ]; then
    printf '      --ephemeral\n'
  fi
  printf '      --ignore-user-config\n'
  printf '      --ignore-rules\n'
  printf '      --color <COLOR>\n'
  printf '      --json\n'
  printf '  -o, --output-last-message <FILE>\n'
  exit "${CODEX_STUB_HELP_RC:-0}"
fi

# `codex debug prompt-input …` validates the config and exits WITHOUT calling
# the model. It deliberately shares nothing with the exec branch below — in
# particular it does not advance the invocation counter, so a test can prove
# that scripts/config-probe.sh never started a real turn simply by asserting
# that no argv was ever recorded.
if [ "${1:-}" = "debug" ]; then
  stub_prev=""
  for a in "$@"; do
    if [ "$stub_prev" = "-c" ]; then
      stub_key="${a%%=*}"
      stub_val="${a#*=}"
      case " ${CODEX_STUB_CONFIG_REJECT:-} " in
        *" $stub_key "*)
          printf 'Error: unknown variant `%s` in `%s`\n' "$stub_val" "$stub_key" >&2
          exit 1
          ;;
      esac
    fi
    stub_prev="$a"
  done
  exit "${CODEX_STUB_DEBUG_RC:-0}"
fi

# --- exec branch ------------------------------------------------------------
N_FILE="$CODEX_STUB_LOG.n"
N=0
if [ -f "$N_FILE" ]; then
  N="$(cat "$N_FILE" 2>/dev/null || printf '0')"
fi
case "$N" in '' | *[!0-9]*) N=0 ;; esac
N=$((N + 1))
printf '%s\n' "$N" >"$N_FILE"

ARGV=""
SEP=""
for a in "$@"; do
  ARGV="$ARGV$SEP$a"
  SEP="$STUB_US"
done
printf '%s' "$ARGV" >"$CODEX_STUB_LOG.argv.$N"

# Drain the prompt BEFORE emitting anything: the callers pipe us into tee and
# would deadlock on a large prompt otherwise, and the recorded stdin is what the
# tests assert the rendered template against.
cat >"$CODEX_STUB_LOG.stdin.$N"

# Snapshot the heartbeat while the turn is RUNNING. This is the only moment the
# "running heartbeat carries the NDJSON path" contract is observable: by the
# time the caller returns, hb_end has already overwritten it.
HB_FILE="${CODEX_STUB_HB_FILE:-${CLAUDE_PROJECT_DIR:-}/.tandem/state/current.json}"
if [ -n "$HB_FILE" ] && [ -f "$HB_FILE" ]; then
  cp "$HB_FILE" "$CODEX_STUB_LOG.hb.$N" 2>/dev/null || true
fi

# Concurrency census. The marker goes up FIRST so this turn counts itself, and
# the count is taken before any sleep: it is the number of codex turns that were
# genuinely running at the moment this one started. `find`, never `ls` — the
# stub is shellchecked like everything else in tests/.
if [ -n "${CODEX_STUB_CONC_DIR:-}" ]; then
  mkdir -p "$CODEX_STUB_CONC_DIR" 2>/dev/null || true
  STUB_CONC_MARK="$CODEX_STUB_CONC_DIR/running.$$"
  : >"$STUB_CONC_MARK"
  trap 'rm -f "$STUB_CONC_MARK"' EXIT
  find "$CODEX_STUB_CONC_DIR" -mindepth 1 -maxdepth 1 | wc -l | tr -d ' ' \
    >"$CODEX_STUB_LOG.conc.$N"
fi

WANT_JSON=0
OUT_LAST=""
STUB_MODEL=""
prev=""
for a in "$@"; do
  [ "$a" = "--json" ] && WANT_JSON=1
  [ "$prev" = "--output-last-message" ] && OUT_LAST="$a"
  [ "$prev" = "--model" ] && STUB_MODEL="$a"
  prev="$a"
done

# --- per-model selectivity ---------------------------------------------------
# Checked before the global knobs so a multi-model caller can single one out.
if [ -n "${CODEX_STUB_HANG_MODEL:-}" ] && [ "$STUB_MODEL" = "$CODEX_STUB_HANG_MODEL" ]; then
  # CODEX_STUB_HANG_RESISTANT=1 forks a child that IGNORES TERM and records its
  # pid in CODEX_STUB_HANG_PIDFILE: the caller's watchdog must complete its
  # TERM->KILL sequence for that child to die, which is exactly the contract the
  # doctor's smoke cleanup test asserts.
  if [ "${CODEX_STUB_HANG_RESISTANT:-0}" = "1" ]; then
    (
      trap '' TERM
      sleep "${CODEX_STUB_HANG_SECONDS:-600}"
    ) &
    if [ -n "${CODEX_STUB_HANG_PIDFILE:-}" ]; then
      printf '%s\n' "$!" >"$CODEX_STUB_HANG_PIDFILE"
    fi
  fi
  sleep "${CODEX_STUB_HANG_SECONDS:-600}"
  exit 0
fi
if [ -n "${CODEX_STUB_FAIL_MODEL:-}" ] && [ "$STUB_MODEL" = "$CODEX_STUB_FAIL_MODEL" ]; then
  case "${CODEX_STUB_FAIL_KIND:-model}" in
    model)
      # The SEMANTICS of an unavailable model, the way the API words it.
      printf 'Error: The model `%s` does not exist or you do not have access to it.\n' \
        "$STUB_MODEL" >&2
      ;;
    *)
      # An auth failure that MENTIONS the model: a classifier keying on the
      # mere presence of the name would call this a deprecation.
      printf 'Error: 401 Unauthorized while starting a turn (model: %s). Run `codex login`.\n' \
        "$STUB_MODEL" >&2
      ;;
  esac
  exit "${CODEX_STUB_EXIT:-7}"
fi

if [ -n "${CODEX_STUB_SLEEP:-}" ]; then
  sleep "$CODEX_STUB_SLEEP"
fi
if [ "$SCENARIO" = "hang" ]; then
  # Long enough that only the runner watchdog can end it.
  sleep "${CODEX_STUB_HANG_SECONDS:-600}"
  exit 0
fi

emit() {
  [ "$WANT_JSON" -eq 1 ] || return 0
  printf '%s\n' "$1"
}

emit_events() {
  if [ -n "${CODEX_STUB_FIXTURE:-}" ]; then
    [ "$WANT_JSON" -eq 1 ] || return 0
    cat "$CODEX_STUB_FIXTURE"
    return 0
  fi
  case "$SCENARIO" in
    no-thread-event)
      : ;;
    multi-thread-started)
      emit "{\"type\":\"thread.started\",\"thread_id\":\"$TID\"}"
      ;;
    resume-fallback)
      emit "{\"type\":\"thread.started\",\"thread_id\":\"$TID2\"}"
      ;;
    corrupt-ndjson)
      emit 'not json at all'
      emit '{"type":"thread.started","thread_id":'
      emit "{\"type\":\"thread.started\",\"thread_id\":\"$TID\"}"
      ;;
    *)
      emit "{\"type\":\"thread.started\",\"thread_id\":\"$TID\"}"
      ;;
  esac

  emit '{"type":"item.started","item":{"item_type":"command_execution","command":"echo   hello\nworld"}}'
  emit '{"type":"item.completed","item":{"item_type":"command_execution","command":"echo hello","exit_code":0}}'

  if [ "$SCENARIO" = "multi-thread-started" ]; then
    emit "{\"type\":\"thread.started\",\"thread_id\":\"$TID2\"}"
  fi
  if [ "$SCENARIO" = "corrupt-ndjson" ]; then
    emit '}{ still garbage'
  fi

  case "$SCENARIO" in
    fail)
      emit '{"type":"turn.failed","error":{"message":"stub forced failure"}}'
      ;;
    *)
      # Usage values overridable per invocation so a retry test can tell two
      # attempts' ledger entries apart; defaults preserve every existing
      # assertion.
      emit "{\"type\":\"turn.completed\",\"usage\":{\"input_tokens\":${CODEX_STUB_TOKENS_IN:-1234},\"output_tokens\":${CODEX_STUB_TOKENS_OUT:-56}}}"
      ;;
  esac
}

reply_text() {
  if [ -n "${CODEX_STUB_REPLY_FILE:-}" ] && [ -f "$CODEX_STUB_REPLY_FILE" ]; then
    cat "$CODEX_STUB_REPLY_FILE"
    return 0
  fi
  if [ -n "${CODEX_STUB_REPLY:-}" ]; then
    printf '%s\n' "$CODEX_STUB_REPLY"
    return 0
  fi
  case "$SCENARIO" in
    verdict-multi)
      printf 'first pass\nVERDICT: NEEDS_REWORK\nsecond thoughts\nVERDICT:  APPROVED\n'
      ;;
    *)
      printf 'stub reply for %s\n' "$SCENARIO"
      ;;
  esac
}

emit_events

# `empty-reply` and `fail` deliberately do NOT write the last-message file: the
# callers pre-delete it, so a stale reply from a previous turn can never be
# mistaken for this turn's output — that pre-deletion is only observable here.
case "$SCENARIO" in
  empty-reply | fail) : ;;
  *)
    if [ -n "$OUT_LAST" ]; then
      reply_text >"$OUT_LAST"
    fi
    ;;
esac

if [ "$SCENARIO" = "fail" ]; then
  printf 'codex-stub: forced failure (scenario=fail)\n' >&2
  exit "${CODEX_STUB_EXIT:-7}"
fi

exit 0

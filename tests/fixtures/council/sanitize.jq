reduce (paths(type == "string")) as $p (.; ($p[-1]) as $k | if (($k|type) == "string") and ($k | IN("type","name","id","model","role","tool_use_id","stop_reason","stop_sequence","timestamp","version","entrypoint","service_tier","speed","inference_geo","userType","permissionDecision")) then . else setpath($p; "<x>") end) | if .type == "assistant" then (.message.content |= (if type == "array" then map(if (.type == "tool_use" and .name == "SubagentHandback") then .input.message = $payload else . end) else . end)) else . end
